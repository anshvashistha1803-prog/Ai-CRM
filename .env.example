# Environment Configuration — AI Real Estate CRM
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

# ─── Application ─────────────────────────────────────────────────────────────
ENVIRONMENT=development          # development | staging | production
DEBUG=true
SECRET_KEY=change-me-to-a-random-64-char-string-in-production
APP_ENCRYPTION_KEY=change-me-32-bytes-minimum-for-aes256!!  # exactly 32 chars

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://crm_app:yourpassword@localhost:5432/crm_dev
DATABASE_URL_SYNC=postgresql+psycopg2://crm_app:yourpassword@localhost:5432/crm_dev  # Alembic only

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── JWT (RS256 — generate with: openssl genrsa -out private.pem 2048) ────────
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── LLM Provider ─────────────────────────────────────────────────────────────
LLM_PROVIDER=openai              # openai | gemini | ollama | mock
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o
LLM_TEMPERATURE=0.1              # Low temperature for structured extraction
LLM_MAX_TOKENS=1000

# ─── WhatsApp Cloud API ───────────────────────────────────────────────────────
# These are set per-tenant in the DB (encrypted).
# The values below are platform-level defaults for webhook verification.
WHATSAPP_APP_SECRET=your-meta-app-secret-here
WHATSAPP_VERIFY_TOKEN=your-custom-verify-token-here
WHATSAPP_API_VERSION=v19.0
WHATSAPP_BASE_URL=https://graph.facebook.com

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@yourdomain.com
SMTP_USE_TLS=true

# ─── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_DEFAULT=300/minute

# ─── File Storage (Cloudflare R2 / S3-compatible) ─────────────────────────────
S3_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=your-r2-access-key
S3_SECRET_ACCESS_KEY=your-r2-secret-key
S3_BUCKET_NAME=crm-property-photos
S3_PUBLIC_URL=https://your-cdn-domain.com

# ─── Celery ───────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ─── Outbox ───────────────────────────────────────────────────────────────────
OUTBOX_POLL_INTERVAL_SECONDS=30
OUTBOX_MAX_RETRIES=3

# ─── Stalled Lead Detection ───────────────────────────────────────────────────
DEFAULT_STALL_THRESHOLD_DAYS=7

# ─── Google OAuth & Sheets Integration ─────────────────────────────────────────
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
# OAuth 2.0 Client ID (Web Application)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Exact callback URI registered in Google Cloud Console
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google/callback
# Optional dedicated HMAC secret for OAuth state token signing (defaults to APP_ENCRYPTION_KEY if empty)
GOOGLE_OAUTH_STATE_SECRET=
# Operational sync mode: mock (offline tests & local dev) | real (live Google API)
GOOGLE_SHEETS_MODE=mock
GOOGLE_SHEETS_SPREADSHEET_ID=your-google-spreadsheet-id
# Service account fallback JSON (optional, only if using service account auth)
GOOGLE_SHEETS_CREDENTIALS_JSON=

# ─── Sentry (optional) ────────────────────────────────────────────────────────
SENTRY_DSN=
