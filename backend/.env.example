# Environment Configuration Template — AI Real Estate CRM
# Copy this file to .env and fill in your actual values.
# DO NOT COMMIT .env TO GIT.

# ─── Application ─────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=crm-dev-secret-key-at-least-32-chars-long-local-environment!
APP_ENCRYPTION_KEY=crm-dev-aes256-key-32-bytes-long!

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://havn_user:HavnDev@localhost:5433/havn_crm
DATABASE_URL_SYNC=postgresql+psycopg://havn_user:HavnDev@localhost:5433/havn_crm

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── JWT (RS256) ──────────────────────────────────────────────────────────────
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── LLM Provider ─────────────────────────────────────────────────────────────
# Set to 'mock' for local offline testing, or 'openai' / 'gemini' for live AI
LLM_PROVIDER=mock
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1000

# ─── WhatsApp Cloud API ───────────────────────────────────────────────────────
WHATSAPP_APP_SECRET=your-meta-app-secret-here
WHATSAPP_VERIFY_TOKEN=crm-verify-token-local-dev
WHATSAPP_API_VERSION=v19.0
WHATSAPP_BASE_URL=https://graph.facebook.com

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@havnrealty.com
SMTP_USE_TLS=true

# ─── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_DEFAULT=300/minute

# ─── File Storage (Cloudflare R2 / S3-compatible) ─────────────────────────────
S3_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=crm-property-photos
S3_PUBLIC_URL=https://your-cdn-domain.com

# ─── Celery ───────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ─── Outbox ───────────────────────────────────────────────────────────────────
OUTBOX_POLL_INTERVAL_SECONDS=30
OUTBOX_MAX_RETRIES=3

# ─── Stalled Lead Detection ───────────────────────────────────────────────────
DEFAULT_STALL_THRESHOLD_DAYS=7

# ─── Google OAuth 2.0 & Sheets Integration ────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google/callback
GOOGLE_OAUTH_STATE_SECRET=crm-google-oauth-state-hmac-secret-key-32chars!
GOOGLE_SHEETS_MODE=mock
GOOGLE_SHEETS_SPREADSHEET_ID=your-spreadsheet-id
GOOGLE_SHEETS_CREDENTIALS_JSON=

# ─── Sentry ───────────────────────────────────────────────────────────────────
SENTRY_DSN=
